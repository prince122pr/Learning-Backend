<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login | Chatgpt-AI</title>
    <link rel="stylesheet" href="/styles/auth-form.css">
</head>

<body>
    <div class="theme-toggle">
        <button id="toggleTheme" aria-label="Toggle theme">🌙</button>
    </div>
    <div class="register-container">
        <h1>Login</h1>
        <form class="register-form" method="POST" action="/auth/login">
            <div class="form-group">
                <label for="email">Email or Username</label>
                <input type="text" id="email" name="userData" required autocomplete="username"
                    placeholder="Email or Username">
            </div>
            <div class="form-group">
                <label for="password">Password</label>
                <input type="password" id="password" name="password" required autocomplete="current-password"
                    placeholder="Your password">
            </div>
            <button type="submit" class="btn-register">Sign In</button>
            <div class="form-links">
                <a href="/auth/forgot" class="forgot-link">Forgot password?</a>
                <span> | </span>
                <a href="/auth/register" class="register-link">Create account</a>
            </div>
        </form>
    </div>
    
        <script src="/scripts/theme-toggle.js"></script>

</body>

</html>